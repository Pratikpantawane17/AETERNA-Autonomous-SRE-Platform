# Kubernetes connectivity
K8S_MODE=kubeconfig
K8S_KUBECONFIG_PATH=
K8S_CONTEXT=
K8S_NAMESPACES=default,aeterna-sample
K8S_COLLECTION_INTERVAL=30

# Core AETERNA backend
AETERNA_CORE_URL=http://backend:8000
AETERNA_API_KEY=cummins-demo-key

# Database (same as main backend)
DATABASE_URL=postgresql://aeterna:aeterna@postgres:5432/aeterna

# JWT Authentication
JWT_SECRET=aeterna-k8s-production-secret-change-me

# Server
K8S_BACKEND_PORT=8001
